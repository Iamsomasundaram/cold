# ---------------------------------------------------------------------------
# env.example — k6 v2 Cold-Storage Simulator
# ---------------------------------------------------------------------------
# How to use:
#   1) Copy to .env (optional) or pass via -e in docker / PowerShell
#   2) All three scripts support the SAME env contract:
#        steady_traffic.js, busy_hour_traffic.js, burst_traffic.js
#
# Notes:
# - Defaults come from K6_CONFIG (JSON) unless overridden here.
# - Some defaults are script-specific (LOAD_PROFILE default differs per script).
# - DRY_RUN never sends HTTP; it prints plan + payload previews.
# ---------------------------------------------------------------------------


# =========================
# 1) CONFIG + PROFILE PICK
# =========================

# Path to the profiles JSON file inside the container/workdir.
# Default: ./k6_profiles.v1.json
K6_CONFIG=./k6_profiles.v1.json

# Which Load Profile to use from config.load_profiles[]
# Allowed: LP1 | LP2 | LP3 (or more if you add)
# Default:
#   - steady_traffic.js -> LP1
#   - busy_hour_traffic.js -> LP2
#   - burst_traffic.js -> LP3
LOAD_PROFILE=LP1

# Which Data Profile to use from config.data_profiles[]
# Allowed: DP1 | DP2 | DP3 | DP4 | DP5 (or more if you add)
# Default: DP1
DATA_PROFILE=DP1


# =========================
# 2) TENANT SELECTION MODE
# =========================

# Tenant mode for event generation
# Allowed: single | weighted
# Default: weighted
TENANT_MODE=weighted

# Required ONLY when TENANT_MODE=single
# Allowed: potato_wh | healthcare_fac (or more if you add)
TENANT_KEY=potato_wh

# Optional override ONLY when TENANT_MODE=weighted
# Format: "<w1>,<w2>,<w3>..." in the SAME ORDER as globals.tenants[] in K6_CONFIG
# Example: "90,10" means first tenant gets 90%, second gets 10%
# Default: uses globals.tenants[].weight from K6_CONFIG
TENANT_DISTRIBUTION=70,30


# =========================
# 3) ENDPOINT (ingest-api)
# =========================

# Base URL for ingest-api
# Default: http://localhost:8080
ENDPOINT_BASE_URL=http://localhost:8080

# Path for ingest endpoint
# Default: globals.endpoint.path from K6_CONFIG (fallback: /api/v1/events)
ENDPOINT_PATH=/api/v1/events


# =========================
# 4) RUN IDENTITY / TRACE
# =========================

# Free-form label to tag runs for logs, dashboards, DB queries
# Default: auto-generated "<LP>_<DP>_<TENANT_MODE>_<timestamp>"
RUN_LABEL=potato_baseline_lp1_dp1

# Optional: seed for repeatability (currently logged/available; deterministic RNG can be added later)
# Default: empty (random)
SEED=


# =========================
# 5) LOAD OVERRIDES (quick)
# =========================

# Override events/second (EPS) for CONSTANT_EPS and baseline for BURSTY
# Default: from selected LOAD_PROFILE.rate_model.events_per_second (or baseline_eps)
EVENTS_PER_SECOND=40

# Override duration in seconds
# Default: from selected LOAD_PROFILE.duration_seconds
DURATION_SECONDS=1800


# =========================
# 6) METRIC MIX OVERRIDE
# =========================

# Override metric category distribution (percent weights).
# Categories must match keys in globals.metric_registry and tenant sensor_codes buckets.
# Format: "TEMP=30,HUMIDITY=15,DOOR=20,GAS=15,LIGHT=10,ENERGY=10"
# Default: DP override if present else globals.default_metric_mix_percent
METRIC_MIX=


# =========================
# 7) TIMESTAMP / ORDERING POLICIES
# =========================

# Inject out-of-order timestamps (small backward jitter)
# Range: 0.0 - 1.0
# Default: globals.timestamp_policy.out_of_order_rate (or DP override)
OUT_OF_ORDER_RATE=0

# Inject late events (observed_at far in the past)
# Range: 0.0 - 1.0
# Default: globals.timestamp_policy.late_event_rate (or DP override)
LATE_EVENT_RATE=0

# Max lateness in seconds for late events
# Default: globals.timestamp_policy.max_lateness_seconds (or DP override)
MAX_LATENESS_SECONDS=300


# =========================
# 8) PAYLOAD / TAG POLICIES
# =========================

# Include tags object in payload
# Allowed: true | false
# Default: globals.payload_policy.tags_enabled (or DP override) (fallback true)
TAGS_ENABLED=true

# Include raw_payload JSON blob (for JSONB bloat / bandwidth tests)
# Allowed: ON | OFF
# Default: globals.payload_policy.raw_payload_mode (or DP override)
RAW_PAYLOAD_MODE=OFF

# Raw payload size when RAW_PAYLOAD_MODE=ON
# Allowed: SMALL | MEDIUM | LARGE
# Default: globals.payload_policy.raw_payload_size (or DP override)
RAW_PAYLOAD_SIZE=SMALL


# =========================
# 9) IDEMPOTENCY / DUPLICATES
# =========================

# Duplicate event injection rate (re-sends previously generated event body)
# Range: 0.0 - 1.0
# Default: globals.idempotency_policy.duplicate_event_rate (or DP override)
DUPLICATE_EVENT_RATE=0


# =========================
# 10) VIOLATIONS (DP2 style)
# =========================

# If violations.enabled=true in the selected Data Profile, this controls how often
# an out-of-range event is emitted (rate is probabilistic per generated event).
# Range: 0.0 - 1.0
# Default: dp.violations.rate (if defined), otherwise 0
#
# Note: For DP3 (incident bundle), we recommend violations.enabled=false
VIOLATION_RATE=0


# =========================
# 11) FAULT INJECTION (DP5 style)
# =========================

# Unknown sensor_code injection rate
# Range: 0.0 - 1.0
# Default: dp.fault_injection.unknown_sensor_rate (or 0)
UNKNOWN_SENSOR_RATE=0

# Invalid metric injection rate
# Range: 0.0 - 1.0
# Default: dp.fault_injection.invalid_metric_rate (or 0)
INVALID_METRIC_RATE=0

# Bad unit injection rate
# Range: 0.0 - 1.0
# Default: dp.fault_injection.bad_unit_rate (or 0)
BAD_UNIT_RATE=0

# Bad JSON injection rate (sends invalid JSON string body)
# Range: 0.0 - 1.0
# Default: dp.fault_injection.bad_json_rate (or 0)
BAD_JSON_RATE=0


# =========================
# 12) DRY RUN / DEBUGGING
# =========================

# Dry-run mode (prints plan + payload preview; does NOT send HTTP)
# Allowed: true | false
# Default: false
DRY_RUN=false

# Number of sample payloads printed during DRY_RUN (when preview-all-phases is false)
# Default: 5
DRY_RUN_SAMPLES=5

# For DP3 incident bundles: prints one payload per incident phase, with realistic observed_at offsets
# Allowed: true | false
# Default: false
DRY_RUN_PREVIEW_ALL_PHASES=false


# =========================
# 13) OPTIONAL k6 / HTTP DEBUG HELPERS
# =========================

# If you want request/response debug from k6 itself, you can run:
#   k6 run --http-debug=full ...
# Or set K6_HTTP_DEBUG=full (k6 standard behavior).
# K6_HTTP_DEBUG=full
#
# Also useful:
# - K6_LOG_LEVEL=debug
# - K6_NO_USAGE_REPORT=true
# (These are k6 standard env vars; not required by our engine.)
