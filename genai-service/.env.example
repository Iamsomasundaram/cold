# Service basics
SERVICE_NAME=genai
NODE_ENV=development
PORT=4100

# Postgres (analytics)
PG_HOST=localhost
PG_PORT=5432
PG_DB=coldstore
PG_USER=coldstore
PG_PASSWORD=coldstore

# Elasticsearch
ES_URL=http://localhost:9200
ES_INDEX=coldstore-detected-events

# GenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Defaults
DEFAULT_TIME_WINDOW_MINUTES=120
