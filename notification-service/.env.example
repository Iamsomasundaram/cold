# Service basics
PORT=4003
NODE_ENV=development

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification
KAFKA_GROUP_ID=coldstore-notification-v1
DETECTED_TOPIC=events.detected.v1
NOTIFICATIONS_TOPIC=events.notifications.v1

# Mongo
MONGO_URL=mongodb://localhost:27017/coldstore_notifications

# Defaults
NOTIFICATION_DEFAULT_WINDOW_SECONDS=300

# Slack
SLACK_WEBHOOK_URL=

# SendGrid (email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_TO_EMAILS=

# Twilio (SMS + WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_SMS_TO=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
